# AFF LAUNCHER Environment Variables
# Copy to .env and fill in real values.

# Stripe (test keys for development, live keys for production)
STRIPE_TEST_SECRET_KEY=sk_test_...
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_...
STRIPE_LIVE_SECRET_KEY=sk_live_...
STRIPE_LIVE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Pricing tiers (Stripe Price IDs — LIVE keys from Stripebot)
STRIPE_PRICE_STARTER=price_1TfNCJ2QG7yt5oO4fAB4OSXg
STRIPE_PRICE_PRO=price_1TfNCk2QG7yt5oO4oaXMSe5U
STRIPE_PRICE_AGENCY=price_1TfNWF2QG7yt5oO40WNiWTn3
STRIPE_PRICE_MAINTENANCE=price_1TfNWY2QG7yt5oO4UeWq76LM

# Fulfillment — email delivery after purchase
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
SMTP_FROM=your@email.com
PRODUCT_DOWNLOAD_URL=https://afflauncher.com/download

# Alert webhooks (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/...
EMAIL_WEBHOOK_URL=

# Vault override (optional)
# AFF_VAULT_PATH=C:\Users\You\.aff_vault

# Logging
# AFF_LOG_LEVEL=INFO

# Retry config
# AFF_MAX_RETRIES=3
# AFF_RETRY_BACKOFF=2.0
