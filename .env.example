# Copy this file to .env and fill in values as needed.

# ── Encryption ────────────────────────────────────────────────────────────────
# If not set, BillPilot auto-generates a Fernet key at data/encryption.key on
# first run. Back that file up — losing it means losing access to stored PII.
DEBT_BOT_ENCRYPTION_KEY=

# ── Tier / Billing ────────────────────────────────────────────────────────────
# Set to "pro" to unlock unlimited usage locally (bypass the 5/month free gate).
# In production this is set by your Stripe webhook after a successful payment.
BILLPILOT_TIER=

# Your real Stripe payment link (create at dashboard.stripe.com → Payment Links).
# The default placeholder in the app will not process real payments.
BILLPILOT_STRIPE_LINK=https://buy.stripe.com/your-real-link-here

# Monthly price shown in upgrade CTAs (default 9.99).
BILLPILOT_PRO_PRICE=9.99

# ── AI Enhancement (Pro feature) ──────────────────────────────────────────────
# Required for "Enhance with AI" button in the Credit Dispute tab.
# Get your key at console.anthropic.com
ANTHROPIC_API_KEY=
