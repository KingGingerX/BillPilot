# Copy this file to .env and fill in values as needed.

# ── Encryption ────────────────────────────────────────────────────────────────
# If not set, BillPilot auto-generates a Fernet key at data/encryption.key on
# first run. Back that file up — losing it means losing access to stored PII.
DEBT_BOT_ENCRYPTION_KEY=

# ── Tier / Billing ────────────────────────────────────────────────────────────
# Set to "pro" to unlock unlimited usage locally (bypass the 5/month free gate).
# In production this is set by your Stripe webhook after a successful payment.
BILLPILOT_TIER=

# Your real Stripe payment link (create at dashboard.stripe.com → Payment Links).
# The default placeholder in the app will not process real payments.
BILLPILOT_STRIPE_LINK=https://buy.stripe.com/your-real-link-here

# Monthly price shown in upgrade CTAs (default 9.99).
BILLPILOT_PRO_PRICE=9.99

# ── AI Features ───────────────────────────────────────────────────────────────
# Required for:
#   • Investor Research tab (AI-powered research + pitch strategy)
#   • "Enhance with AI" button in the Credit Dispute tab
# Get your key at console.anthropic.com
ANTHROPIC_API_KEY=

# ── Investor Research ──────────────────────────────────────────────────────────
# Web search is automatic (DuckDuckGo, no API key needed).
# No additional configuration required for investor research.

# ── Rita's Rewards Outreach Engine ─────────────────────────────────────────────
# Run with: streamlit run ritas2rewards/app.py

# Sender identity
R2R_FROM_EMAIL=outreach@ritasrewards.com
R2R_FROM_NAME=Rita's Rewards
R2R_SENDER_NAME=Alex

# Email delivery: "sendgrid" | "smtp" | "preview" (default; no emails sent)
R2R_EMAIL_PROVIDER=preview

# SendGrid (if R2R_EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=

# SMTP (if R2R_EMAIL_PROVIDER=smtp — works with Gmail app passwords, etc.)
R2R_SMTP_HOST=smtp.gmail.com
R2R_SMTP_PORT=587
R2R_SMTP_USERNAME=
R2R_SMTP_PASSWORD=

# Restaurant discovery APIs (both optional — CSV import always works)
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=

# Program settings
R2R_PROGRAM_URL=https://ritasrewards.com
R2R_HANDOFF_THRESHOLD=60
R2R_DATABASE_PATH=data/ritas2rewards.db
