# Telegram Alerts (get bot token from @BotFather, chat ID from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email Alerts (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=

# Data providers (optional - Yahoo Finance used by default)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
POLYGON_API_KEY=
FINNHUB_API_KEY=

# Optional: pin a real-time data provider ("alpaca", "polygon", "finnhub", "yahoo")
# If unset, auto-selects the first configured provider in priority order.
REALTIME_PROVIDER=

# Scanner settings
MIN_SCORE=7
EXTRA_TICKERS=
