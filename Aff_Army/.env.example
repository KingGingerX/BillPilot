# Server
PORT=3500
NODE_ENV=development
BASE_URL=http://localhost:3500
ADMIN_SECRET=change-me-in-production

# Database (SQLite file path)
DATABASE_URL="file:./aff_army.db"

# Email outreach (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
FROM_NAME=Your Name
FROM_EMAIL=your@gmail.com

# Your main store URL (where affiliates send traffic)
STORE_URL=https://yourstore.com

# Commission cookie TTL in days
COOKIE_TTL_DAYS=30

# Payout minimum threshold in cents (default $25)
PAYOUT_MINIMUM_CENTS=2500

# Stripe (for automated payouts, optional)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Reddit app (for scouting, optional)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Scout schedule (cron syntax)
SCOUT_CRON=0 9 * * *
OUTREACH_CRON=0 10 * * *
PAYOUT_CRON=0 0 * * 1
