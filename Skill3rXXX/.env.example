# =============================================================
# PASSIVE INCOME MASTER SYSTEM — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================

# ── Application ───────────────────────────────────────────────
NODE_ENV=production
PORT=4000
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# ── Database (PostgreSQL) ─────────────────────────────────────
DATABASE_URL=postgresql://pims_user:CHANGE_ME@postgres:5432/pims_db
POSTGRES_USER=pims_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=pims_db

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=CHANGE_ME

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING_HERE
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Encryption ───────────────────────────────────────────────
ENCRYPTION_KEY=CHANGE_ME_32_CHAR_HEX_KEY_HERE

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_REAL_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_REAL_WEBHOOK_SECRET
STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_WITH_REAL_KEY

# Stripe Connect (from stripe.com → Connect → Settings → client_id)
STRIPE_CONNECT_CLIENT_ID=ca_REPLACE_WITH_CONNECT_CLIENT_ID
# Where Stripe redirects after affiliate completes onboarding
STRIPE_CONNECT_RETURN_URL=https://yourdomain.com/affiliates?connect=success
STRIPE_CONNECT_REFRESH_URL=https://yourdomain.com/affiliates?connect=refresh

# ── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=REPLACE_WITH_SENDGRID_API_KEY
SMTP_FROM=noreply@yourdomain.com

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Admin ────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_INITIAL_PASSWORD=CHANGE_ME_ON_FIRST_LOGIN

# ── Content / AI ─────────────────────────────────────────────
OPENAI_API_KEY=sk-REPLACE_WITH_OPENAI_KEY

# ── Analytics ────────────────────────────────────────────────
# Revenue tracking webhook secret (internal)
INTERNAL_WEBHOOK_SECRET=CHANGE_ME_INTERNAL_SECRET
